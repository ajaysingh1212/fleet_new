[Unit]
Description=FleetNova authenticated PT06 TCP receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/FleetNova
ExecStart=/usr/bin/php artisan gps:listen --host=0.0.0.0 --port=9000 --diagnostic --persist --registered --diagnostic-protocol=pt06 --format=json
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
