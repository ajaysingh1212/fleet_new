# Append to the existing deployment environment. Preserve existing secrets,
# Redis/Horizon/mobile queue settings and Reverb credentials.
GPS_HOST=0.0.0.0
GPS_PORT=9000
GPS_CACHE_STORE=gps-redis
GPS_QUEUE_CONNECTION=gps-redis
GPS_REDIS_DB=2
GPS_PENDING_DIAGNOSTICS=false
# Predis is already installed. phpredis also works when its extension exists.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Set REDIS_PASSWORD through your existing secret management mechanism.
# Existing DB_HOST should be loopback/private Cloud SQL address.
APP_ENV=production
APP_DEBUG=false
BROADCAST_CONNECTION=reverb
# Preserve existing REVERB_APP_ID / KEY / SECRET.
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_HOST=tracking.example.com
REVERB_PORT=443
REVERB_SCHEME=https
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
